# Gemini API (Lấy key tại https://aistudio.google.com/apikey rồi dán vào sau dấu =)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# VOICEVOX Local Engine (8=Kasukabe Tsumugi, 0=Shikoku Metan Amaama, 14=Meimei Himari, 1=Zundamon Amaama)
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=8

# Fallback edge-tts tuning (dùng tự động khi VOICEVOX chưa mở)
EDGE_TTS_VOICE=ja-JP-NanamiNeural
EDGE_TTS_PITCH=+12Hz
EDGE_TTS_RATE=+4%

# Speech-to-Text (Faster-Whisper: tiny hoặc base, int8 trên CPU)
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
